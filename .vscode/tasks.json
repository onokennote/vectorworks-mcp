{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vectorworks Search",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "Invoke-WebRequest -Uri \"http://localhost:8001/?q=${input:searchTerm}\" | Select-Object -ExpandProperty Content"
      ],
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "searchTerm",
      "description": "Enter Vectorworks function name",
      "default": "PushAttrs",
      "type": "promptString"
    }
  ]
}